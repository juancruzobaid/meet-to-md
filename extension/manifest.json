{
  "manifest_version": 3,
  "name": "Meet to MD",
  "version": "3.5.1",
  "description": "Google Meet transcripts as Markdown. Private and open source.",
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup/index.html"
  },
  "side_panel": {
    "default_path": "side-panel/index.html"
  },
  "sidebar_action": {
    "default_panel": "side-panel/index.html",
    "default_title": "Meet to MD",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background-script/index.js",
    "scripts": [
      "background-script/index.js"
    ],
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon.png"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "meet-to-md@juancruz.com.ar",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "personalCommunications",
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
