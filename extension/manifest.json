{
  "manifest_version": 3,
  "name": "Meet to MD",
  "version": "3.4.5",
  "description": "Google Meet transcripts as Markdown. Private and open source.",
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup/index.html"
  },
  "side_panel": {
    "default_path": "side-panel/index.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background-script/index.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon.png"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ]
}
